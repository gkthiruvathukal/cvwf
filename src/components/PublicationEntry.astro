---
import type { CollectionEntry } from "astro:content";
import AuthorList from "./AuthorList.astro";

interface Props {
  pub: CollectionEntry<"publications">["data"];
}

const { pub } = Astro.props;

const primaryLink = pub.doi ? `https://doi.org/${pub.doi}` : pub.url;
const venueParts = [pub.venue, pub.volume && `vol. ${pub.volume}`, pub.number && `no. ${pub.number}`, pub.pages && `pp. ${pub.pages}`]
  .filter(Boolean)
  .join(", ");
---

<div class="avoid-break py-2.5 text-sm">
  <div class="text-slate-600"><AuthorList authors={pub.authors} /></div>
  <div class="font-medium">
    {primaryLink ? (
      <a href={primaryLink} target="_blank" rel="noopener noreferrer" class="hover:underline">
        {pub.title}
      </a>
    ) : (
      pub.title
    )}
  </div>
  {venueParts && <div class="italic text-slate-600">{venueParts}, {pub.date}</div>}
  {!venueParts && <div class="text-slate-600">{pub.date}</div>}
  {(pub.arxiv || pub.code || pub.website) && (
    <div class="mt-0.5 flex gap-3 text-xs text-slate-500">
      {pub.arxiv && <a href={`https://arxiv.org/abs/${pub.arxiv}`} class="hover:underline">arXiv</a>}
      {pub.code && <a href={pub.code} class="hover:underline">code</a>}
      {pub.website && <a href={pub.website} class="hover:underline">project site</a>}
    </div>
  )}
</div>
